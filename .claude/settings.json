{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/design-check.mjs",
            "timeout": 150,
            "statusMessage": "Checking the design rules"
          }
        ]
      }
    ]
  }
}
