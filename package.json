{
  "name": "tsumugi",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "tsc -p packages/core && tsc -p scripts && npm run typecheck -w web",
    "test": "vitest run",
    "graph:up": "docker compose -f infra/neo4j/docker-compose.yml --env-file .env up -d --wait",
    "graph:down": "docker compose -f infra/neo4j/docker-compose.yml --env-file .env down",
    "graph:init": "tsx --env-file=.env scripts/graph-init.ts",
    "graph:reset": "tsx --env-file=.env scripts/graph-init.ts --reset",
    "graph:dump": "tsx --env-file=.env scripts/graph-dump.ts",
    "see": "tsx --env-file=.env scripts/see.ts",
    "met": "tsx scripts/met.ts",
    "inference": "cd services/inference && uv run --env-file ../../.env uvicorn app:app --host 127.0.0.1 --port 8100",
    "secrets:scan": "gitleaks detect --source . --redact --no-banner",
    "corpus:ingest": "tsx --env-file=.env scripts/corpus/ingest.ts",
    "corpus:search": "tsx --env-file=.env scripts/corpus/search-cli.ts",
    "corpus:headers": "tsx --env-file=.env scripts/corpus/headers.ts",
    "setup:web-assets": "tsx scripts/fetch-web-assets.ts",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://127.0.0.1:${PORT:-3000}",
    "e2e:explore": "tsx --env-file=.env scripts/e2e-explore.ts",
    "e2e:capture": "tsx --env-file=.env scripts/e2e-capture.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "lefthook": "^1.11.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "neo4j-driver": "^6.3.0",
    "zod": "^4.6.7"
  }
}
