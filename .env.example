# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Daily spend cap (USD). New explorations are refused once exceeded.
DAILY_COST_LIMIT_USD=20

# --- Access control (FR-05) ---
# Long random string. Visit https://<host>/?token=<ACCESS_TOKEN> once; it becomes an HttpOnly cookie.
ACCESS_TOKEN=

# --- Neo4j (infra/neo4j/docker-compose.yml) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Inference server (services/inference) ---
INFERENCE_URL=http://127.0.0.1:8100
INFERENCE_TOKEN=

# --- Hugging Face (SAM 3 is gated; `hf auth login` also works) ---
HF_TOKEN=

# --- Data outside the repository (photos, masks, depth maps, corpora) ---
DATA_DIR=/Users/you/tsumugi-data

# Presentation mode (FR-46): open /api/presenter?key=<PRESENTER_TOKEN> once on the presenting desktop.
PRESENTER_TOKEN=
